{% extends '_layout.twig' %}

{# Les données du hero (page.home) sont fournies par _layout.twig. #}
{% set blocks = include('_blocks.twig', { field: entry.contentBlocks })|trim|json_decode %}

{% if craft.app.config.general.devMode and craft.app.request.getParam('demo') %}
  {% set blocks = blocks|merge(include('_demo-blocks.twig')|trim|json_decode) %}
{% endif %}

{% set page = {
  name: 'home',
  blocks: blocks,
} %}
