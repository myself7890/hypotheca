<!DOCTYPE html>
<html lang="{{ currentSite.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ (pageTitle ?? siteName) ~ (pageTitle is defined ? ' | ' ~ siteName : '') }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  {{ craft.vite.script('src/main.js') }}
</head>
<body>
  <div id="app" data-page="{{ page|json_encode|e('html_attr') }}"></div>
</body>
</html>
