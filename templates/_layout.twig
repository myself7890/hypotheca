{# Données communes à toutes les pages (en-tête, pied de page) #}
{% set ratesEntry = craft.entries.section('rates').one() %}
{% set nav = [{ label: 'Accueil', href: '/' }] %}
{# Page des taux facultative : dans le menu seulement si elle existe et est activée. #}
{% if ratesEntry %}
  {% set nav = nav|merge([{ label: ratesEntry.title, href: '/' ~ ratesEntry.uri }]) %}
{% endif %}

{# Hero (bannière de l'accueil) : présent sur toutes les pages #}
{% set homeEntry = craft.entries.section('home').one() %}
{% set homePhoto = homeEntry ? homeEntry.brokerPhoto.one() : null %}
{% set homeBg = homeEntry ? homeEntry.heroBackground.one() : null %}

{% set page = {
  site: { name: siteName, url: siteUrl },
  home: homeEntry ? {
    brokerName: homeEntry.brokerName,
    title: homeEntry.heroTitle,
    bio: homeEntry.brokerBio,
    licenseNotice: homeEntry.licenseNotice,
    intro: homeEntry.introText,
    ctaLabel: homeEntry.ctaLabel,
    photo: homePhoto ? { url: homePhoto.getUrl({ width: 1400 }), alt: homeEntry.brokerName } : null,
    background: homeBg ? homeBg.getUrl({ width: 2400 }) : null,
  } : null,
  contact: {
    name: contact.contactName,
    phone: contact.phone,
    email: contact.email,
  },
  nav: nav,
  requestUrl: '/demande-en-ligne',
}|merge(page ?? {}) %}
<!DOCTYPE html>
<html lang="{{ currentSite.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ (pageTitle ?? siteName) ~ (pageTitle is defined ? ' | ' ~ siteName : '') }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  {{ craft.vite.script('src/main.js') }}
</head>
<body>
  <div id="app" data-page="{{ page|json_encode|e('html_attr') }}"></div>
</body>
</html>
